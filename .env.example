# Copy to .env for local development. Never commit real secrets.
JARVIS_APP_NAME=JARVIS
JARVIS_USER_NAME=User
JARVIS_USER_TITLE=
JARVIS_PERSONALITY=calm, intelligent, concise, slightly witty, professional, helpful
JARVIS_RESPONSE_STYLE=concise
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_MODEL=mock-1
JARVIS_LLM_TEMPERATURE=0.2
JARVIS_LLM_MAX_TOKENS=1024
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=data
JARVIS_REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true

# Remote web console. Keep the real token only in .env.
JARVIS_API_TOKEN=
JARVIS_CORS_ORIGINS=https://voidforgestudios.github.io

# For Claude/Anthropic locally only:
# JARVIS_LLM_PROVIDER=anthropic
# JARVIS_LLM_MODEL=<your configured Claude model>
# JARVIS_ANTHROPIC_API_KEY=<your secret>
