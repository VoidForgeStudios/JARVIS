# LLM
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_MODEL=mock-1
JARVIS_ANTHROPIC_API_KEY=

# Remote web console security
# Generate a long random value and keep it only in your local .env.
JARVIS_API_TOKEN=
# Comma-separated browser origins allowed to call the API.
JARVIS_CORS_ORIGINS=https://voidforgestudios.github.io

# Runtime
JARVIS_APP_NAME=JARVIS
JARVIS_USER_NAME=User
JARVIS_USER_TITLE=
JARVIS_LOG_LEVEL=INFO
JARVIS_DATA_DIR=data
JARVIS_REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
